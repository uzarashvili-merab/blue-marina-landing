{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/quiz/:step", "destination": "/index.html" },
    { "source": "/results", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/thank-you", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
